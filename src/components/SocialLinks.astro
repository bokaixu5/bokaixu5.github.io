---
import type { Lang } from "../config/i18n";
import { siteConfig } from "../config/site";

type Variant = "home" | "footer";

interface Props {
  lang: Lang;
  variant?: Variant;
}

const { lang, variant = "home" } = Astro.props as Props;
const isZh = lang === "zh";

const labels = {
  email: isZh ? "邮箱" : "Email",
  scholar: isZh ? "Google 学术" : "Google Scholar",
  twitter: "Twitter/X",
  xiaohongshu: isZh ? "小红书" : "Xiaohongshu",
  wechat: isZh ? "微信" : "WeChat",
  wechatQrPlaceholder: isZh ? "二维码待补充" : "QR code coming soon",
  wechatIdLabel: isZh ? "微信号" : "WeChat ID",
  close: isZh ? "关闭" : "Close",
  github: "GitHub",
};
---

<div class={`social-links social-links--${variant}`} data-social-root>
  <a
    class="social-link"
    href={`mailto:${siteConfig.social.email}`}
    aria-label={`${labels.email}: ${siteConfig.social.email}`}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="2" y="4" width="20" height="16" rx="2"></rect>
      <path d="m22 7-10 5L2 7"></path>
    </svg>
    <span class="social-text">{labels.email}</span>
  </a>

  <a
    class="social-link"
    href={siteConfig.social.googleScholar}
    target="_blank"
    rel="noreferrer"
    aria-label={labels.scholar}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M21.42 10.922a1 1 0 0 0 0-1.844l-8.758-4.204a1 1 0 0 0-.87 0L3.034 9.078a1 1 0 0 0 0 1.844l8.758 4.204a1 1 0 0 0 .87 0z"></path>
      <path d="M22 10v6"></path>
      <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path>
    </svg>
    <span class="social-text">{labels.scholar}</span>
  </a>

  <a
    class="social-link"
    href={siteConfig.social.twitter}
    target="_blank"
    rel="noreferrer"
    aria-label={labels.twitter}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M4 4l16 16"></path>
      <path d="M20 4 4 20"></path>
    </svg>
    <span class="social-text">{labels.twitter}</span>
  </a>

  <a
    class="social-link"
    href={siteConfig.social.xiaohongshu}
    target="_blank"
    rel="noreferrer"
    aria-label={labels.xiaohongshu}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M12 7v14"></path>
      <path d="M3 18h6a3 3 0 0 1 3 3 3 3 0 0 1 3-3h6V4h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3H3z"></path>
    </svg>
    <span class="social-text">{labels.xiaohongshu}</span>
  </a>

  <button
    type="button"
    class="social-link social-link--button"
    aria-label={labels.wechat}
    aria-expanded="false"
    data-wechat-trigger
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="m21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      <circle cx="9" cy="10.5" r="1"></circle>
      <circle cx="15" cy="10.5" r="1"></circle>
    </svg>
    <span class="social-text">{labels.wechat}</span>
  </button>

  <a
    class="social-link"
    href={siteConfig.social.github}
    target="_blank"
    rel="noreferrer"
    aria-label={labels.github}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.2c3.3-.4 6.8-1.6 6.8-7.1A5.6 5.6 0 0 0 19.2 4 5.2 5.2 0 0 0 19.1 1S17.7.6 15 2.4a13.4 13.4 0 0 0-6 0C6.3.6 4.9 1 4.9 1A5.2 5.2 0 0 0 4.8 4 5.6 5.6 0 0 0 3.2 7.7c0 5.5 3.5 6.7 6.8 7.1a4.8 4.8 0 0 0-1 3.2v4"></path>
      <path d="M9 18c-4.5 2-5-2-7-2"></path>
    </svg>
    <span class="social-text">{labels.github}</span>
  </a>

  <div class="social-popover" hidden data-wechat-popover role="dialog" aria-label={labels.wechat}>
    <p class="social-popover-title">{labels.wechat}</p>
    <p>{labels.wechatQrPlaceholder}</p>
    <p class="social-popover-id">
      {labels.wechatIdLabel}: {siteConfig.social.wechat}
    </p>
    <button type="button" class="social-popover-close" data-wechat-close>{labels.close}</button>
  </div>
</div>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll("[data-social-root]");
    for (const root of roots) {
      if (!(root instanceof HTMLElement) || root.dataset.wechatBound === "1") {
        continue;
      }
      root.dataset.wechatBound = "1";

      const trigger = root.querySelector("[data-wechat-trigger]");
      const popover = root.querySelector("[data-wechat-popover]");
      const close = root.querySelector("[data-wechat-close]");
      if (!(trigger instanceof HTMLButtonElement) || !(popover instanceof HTMLElement)) {
        continue;
      }

      const setOpen = (open) => {
        popover.hidden = !open;
        trigger.setAttribute("aria-expanded", String(open));
        root.classList.toggle("is-open", open);
      };

      trigger.addEventListener("click", (event) => {
        event.stopPropagation();
        setOpen(popover.hidden);
      });

      if (close instanceof HTMLButtonElement) {
        close.addEventListener("click", () => setOpen(false));
      }

      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Node)) {
          return;
        }
        if (!root.contains(event.target)) {
          setOpen(false);
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setOpen(false);
        }
      });
    }
  })();
</script>
