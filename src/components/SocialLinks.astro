---
import type { Lang } from "../config/i18n";
import { siteConfig } from "../config/site";

type Variant = "home" | "footer";

interface Props {
  lang: Lang;
  variant?: Variant;
}

const { lang, variant = "home" } = Astro.props as Props;
const isZh = lang === "zh";

const labels = {
  email: isZh ? "邮箱" : "Email",
  scholar: isZh ? "Google 学术" : "Google Scholar",
  twitter: "Twitter/X",
  xiaohongshu: isZh ? "小红书" : "Xiaohongshu",
  wechat: isZh ? "微信" : "WeChat",
  close: isZh ? "关闭" : "Close",
  openImage: isZh ? "查看原图" : "Open full-size image",
  github: "GitHub",
};

const qrProfiles = [
  {
    id: `social-${variant}-xiaohongshu`,
    label: labels.xiaohongshu,
    image: siteConfig.social.xiaohongshuQrImage,
    width: 987,
    height: 1347,
    alt: isZh ? "Bokai Xu 的小红书二维码" : "Bokai Xu's Xiaohongshu QR code",
    hint: isZh ? "使用小红书扫一扫，或保存图片后在小红书中识别。" : "Scan with Xiaohongshu, or save the image and scan it in the app.",
  },
  {
    id: `social-${variant}-wechat`,
    label: labels.wechat,
    image: siteConfig.social.wechatQrImage,
    width: 888,
    height: 1131,
    alt: isZh ? "Bokai Xu 的微信二维码" : "Bokai Xu's WeChat QR code",
    hint: isZh ? "使用微信扫一扫，或保存图片后在微信中识别。" : "Scan with WeChat, or save the image and scan it in the app.",
  },
];
---

<div class={`social-links social-links--${variant}`}>
  <a
    class="social-link"
    href={`mailto:${siteConfig.social.email}`}
    aria-label={`${labels.email}: ${siteConfig.social.email}`}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="2" y="4" width="20" height="16" rx="2"></rect>
      <path d="m22 7-10 5L2 7"></path>
    </svg>
    <span class="social-text">{labels.email}</span>
  </a>

  <a
    class="social-link"
    href={siteConfig.social.googleScholar}
    target="_blank"
    rel="noreferrer"
    aria-label={labels.scholar}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M21.42 10.922a1 1 0 0 0 0-1.844l-8.758-4.204a1 1 0 0 0-.87 0L3.034 9.078a1 1 0 0 0 0 1.844l8.758 4.204a1 1 0 0 0 .87 0z"></path>
      <path d="M22 10v6"></path>
      <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path>
    </svg>
    <span class="social-text">{labels.scholar}</span>
  </a>

  <a
    class="social-link"
    href={siteConfig.social.twitter}
    target="_blank"
    rel="noreferrer"
    aria-label={labels.twitter}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M4 4l16 16"></path>
      <path d="M20 4 4 20"></path>
    </svg>
    <span class="social-text">{labels.twitter}</span>
  </a>

  <button
    type="button"
    class="social-link social-link--button"
    aria-label={labels.xiaohongshu}
    aria-haspopup="dialog"
    aria-controls={`social-${variant}-xiaohongshu`}
    data-social-qr-trigger
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M12 7v14"></path>
      <path d="M3 18h6a3 3 0 0 1 3 3 3 3 0 0 1 3-3h6V4h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3H3z"></path>
    </svg>
    <span class="social-text">{labels.xiaohongshu}</span>
  </button>

  <button
    type="button"
    class="social-link social-link--button"
    aria-label={labels.wechat}
    aria-haspopup="dialog"
    aria-controls={`social-${variant}-wechat`}
    data-social-qr-trigger
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="m21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      <circle cx="9" cy="10.5" r="1"></circle>
      <circle cx="15" cy="10.5" r="1"></circle>
    </svg>
    <span class="social-text">{labels.wechat}</span>
  </button>

  <a
    class="social-link"
    href={siteConfig.social.github}
    target="_blank"
    rel="noreferrer"
    aria-label={labels.github}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.2c3.3-.4 6.8-1.6 6.8-7.1A5.6 5.6 0 0 0 19.2 4 5.2 5.2 0 0 0 19.1 1S17.7.6 15 2.4a13.4 13.4 0 0 0-6 0C6.3.6 4.9 1 4.9 1A5.2 5.2 0 0 0 4.8 4 5.6 5.6 0 0 0 3.2 7.7c0 5.5 3.5 6.7 6.8 7.1a4.8 4.8 0 0 0-1 3.2v4"></path>
      <path d="M9 18c-4.5 2-5-2-7-2"></path>
    </svg>
    <span class="social-text">{labels.github}</span>
  </a>

  {
    qrProfiles.map((profile) => (
      <dialog
        id={profile.id}
        class="social-qr-dialog"
        aria-labelledby={`${profile.id}-title`}
        aria-describedby={`${profile.id}-hint`}
      >
        <div class="social-qr-header">
          <h2 id={`${profile.id}-title`}>{profile.label}</h2>
          <form method="dialog">
            <button type="submit" class="social-qr-close">{labels.close}</button>
          </form>
        </div>
        <img
          class="social-qr-image"
          src={profile.image}
          alt={profile.alt}
          width={profile.width}
          height={profile.height}
          loading="lazy"
          decoding="async"
        />
        <p id={`${profile.id}-hint`} class="social-qr-hint">{profile.hint}</p>
        <a class="social-qr-original" href={profile.image} target="_blank" rel="noreferrer">
          {labels.openImage}
        </a>
      </dialog>
    ))
  }
</div>

<script>
  for (const trigger of document.querySelectorAll<HTMLButtonElement>("[data-social-qr-trigger]")) {
    const dialog = document.getElementById(trigger.getAttribute("aria-controls") ?? "");
    if (!(dialog instanceof HTMLDialogElement)) {
      continue;
    }

    trigger.addEventListener("click", () => dialog.showModal());
    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) {
        return;
      }
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right ||
          event.clientY < rect.top || event.clientY > rect.bottom) {
        dialog.close();
      }
    });
  }
</script>
