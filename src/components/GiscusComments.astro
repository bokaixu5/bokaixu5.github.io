---
import type { Lang } from "../config/i18n";

interface Props {
  lang: Lang;
  term: string;
}

const { lang, term } = Astro.props as Props;
const repo = import.meta.env.PUBLIC_GISCUS_REPO;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const isEnabled = Boolean(repo && repoId && category && categoryId);
const giscusLang = lang === "zh" ? "zh-CN" : "en";
---

<section class="reveal" style="margin-top:2rem;" data-giscus-root>
  {
    isEnabled ? (
      <div class="panel">
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={repo}
          data-repo-id={repoId}
          data-category={category}
          data-category-id={categoryId}
          data-mapping="specific"
          data-term={term}
          data-strict="1"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="top"
          data-theme="preferred_color_scheme"
          data-lang={giscusLang}
          crossorigin="anonymous"
          async
        ></script>
        <script is:inline>
          (() => {
            const root = document.currentScript?.closest("[data-giscus-root]");
            if (!(root instanceof HTMLElement)) {
              return;
            }

            const syncGiscusTheme = () => {
              const frame = root.querySelector("iframe.giscus-frame");
              if (!(frame instanceof HTMLIFrameElement) || !frame.contentWindow) {
                return;
              }
              frame.contentWindow.postMessage(
                { giscus: { setConfig: { theme: document.body.classList.contains("dark") ? "dark" : "light" } } },
                "https://giscus.app",
              );
            };

            const onThemeChange = () => window.requestAnimationFrame(syncGiscusTheme);

            window.addEventListener("site-theme-change", onThemeChange);
            window.addEventListener("message", (event) => {
              if (event.origin !== "https://giscus.app") {
                return;
              }
              onThemeChange();
            });

            setTimeout(syncGiscusTheme, 350);
          })();
        </script>
      </div>
    ) : (
      <p class="panel" style="color:var(--muted);">
        {lang === "zh"
          ? "未配置 Giscus 环境变量，评论区将在配置后启用。"
          : "Giscus env vars are missing. Comments will appear after setup."}
      </p>
    )
  }
</section>
