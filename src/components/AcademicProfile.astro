---
import { getEntry, render } from "astro:content";
import type { Lang } from "../config/i18n";

interface Props {
  lang: Lang;
  variant?: "summary" | "detailed";
}

const { lang, variant = "summary" } = Astro.props;
const profileId = variant === "detailed" ? `${lang}-detailed` : lang;
const profile = await getEntry("profile", profileId);
if (!profile) {
  throw new Error(`Missing academic profile: ${profileId}`);
}
const { Content } = await render(profile);
---

<div class:list={["academic-profile", "content-prose", { "academic-profile--detailed": variant === "detailed" }]}>
  <Content />
</div>

<style>
  .academic-profile {
    max-width: none;
  }

  .academic-profile :global(h2) {
    margin-top: 2rem;
    scroll-margin-top: 160px;
  }

  .academic-profile :global(h2:first-child) {
    margin-top: 0;
  }

  .academic-profile--detailed :global(li) {
    margin-bottom: 0.7rem;
  }

  .academic-profile :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
