---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SUPPORTED_LANGS, getOtherLang, t, type Lang } from "../../../config/i18n";
import { siteConfig } from "../../../config/site";
import { publications } from "../../../config/publications";

export function getStaticPaths() {
  return SUPPORTED_LANGS.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props as Props;
const text = t(lang);
const otherLang = getOtherLang(lang);
---

<BaseLayout
  lang={lang}
  title={text.publications.title}
  description={text.publications.subtitle}
  currentPath={`/${lang}/publications/`}
  alternateHref={`/${otherLang}/publications/`}
>
  <section class="panel reveal" style="margin-bottom:1rem;">
    <h1>{text.publications.title}</h1>
    <p style="color:var(--muted);margin-bottom:0;">{text.publications.subtitle}</p>
  </section>

  <section class="publication-list" aria-label={text.publications.subtitle}>
    {
      publications.map((publication) => (
        <article class="publication-card reveal">
          <div class="publication-thumbnail">
            {publication.thumbnail ? (
              <img
                src={publication.thumbnail.src}
                alt={publication.thumbnail.alt}
                width="480"
                height="336"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="publication-cover" aria-hidden="true">
                <span>WIRELESS COMMUNICATIONS</span>
                <strong>{publication.coverLabel}</strong>
                <span>IEEE JSAC / {publication.year}</span>
              </div>
            )}
          </div>
          <div class="publication-details">
            <h2 class="publication-title">
              <a href={publication.href} target="_blank" rel="noreferrer">
                {publication.title}
              </a>
            </h2>
            <p class="publication-authors">
              {publication.authors.map((author, index) => (
                <>
                  {index > 0 && ", "}
                  {author === siteConfig.brandName ? <strong>{author}</strong> : author}
                </>
              ))}.
            </p>
            <p class="publication-venue">
              {publication.venue}, {publication.year}
              {publication.status === "accepted" && (lang === "zh" ? "（已录用）" : " (Accepted)")}
            </p>
            {publication.bestPaperAward && (
              <p class="publication-award">
                {lang === "zh" ? "最佳论文奖" : "Best Paper Award"}
              </p>
            )}
            <div class="publication-links">
              {publication.arxivId ? (
                <a
                  href={`https://arxiv.org/abs/${publication.arxivId}`}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`arXiv: ${publication.title}`}
                >
                  [<span>arXiv</span>]
                </a>
              ) : (
                <a
                  href={publication.href}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`Paper: ${publication.title}`}
                >
                  [<span>Paper</span>]
                </a>
              )}
              {(publication.arxivId || publication.pdfHref) && (
                <a
                  href={publication.arxivId
                    ? `https://arxiv.org/pdf/${publication.arxivId}`
                    : publication.pdfHref}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`PDF${publication.arxivId ? " (arXiv)" : ""}: ${publication.title}`}
                >
                  [<span>PDF</span>]
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section class="panel reveal" style="margin-top:1rem;">
    <p style="margin:0;">
      <a href={siteConfig.social.googleScholar} target="_blank" rel="noreferrer">
        {text.publications.morePapers}
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .publication-list {
    --publication-border: #e0e9f6;
    --publication-accent: #c2cde1;
    --publication-blue: #2e5db3;
    --publication-link: #926500;
    display: grid;
    gap: 1.4rem;
  }

  .publication-card {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    align-items: start;
    gap: 2rem;
    padding: 1.8rem;
    border: 2px solid var(--publication-border);
    border-left: 7px solid var(--publication-accent);
    border-radius: 20px;
    background: var(--panel);
    box-shadow: 0 8px 26px rgb(58 83 126 / 5%);
  }

  .publication-thumbnail {
    overflow: hidden;
    aspect-ratio: 10 / 7;
    border: 2px solid var(--publication-border);
    border-radius: 12px;
    background: #fff;
  }

  .publication-thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8px;
  }

  .publication-cover {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 0.5rem;
    padding: 0.5rem;
    color: #2e5db3;
    background: linear-gradient(145deg, #fff, #edf3fc);
  }

  .publication-cover span {
    font-size: 0.48rem;
    letter-spacing: 0.07em;
  }

  .publication-cover strong {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.1rem;
  }

  .publication-details {
    min-width: 0;
    font-family: Georgia, "Times New Roman", serif;
  }

  .publication-title {
    margin: 0 0 0.9rem;
    font-size: clamp(1.35rem, 2.5vw, 1.7rem);
    line-height: 1.18;
  }

  .publication-title a {
    border: 0;
  }

  .publication-title a:hover {
    color: var(--publication-blue);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .publication-authors {
    margin: 0 0 0.25rem;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.5;
  }

  .publication-authors strong {
    color: var(--ink);
  }

  .publication-venue {
    margin: 0 0 0.3rem;
    color: var(--publication-blue);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .publication-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 1.2rem;
  }

  .publication-award {
    display: table;
    max-width: 100%;
    margin: 0.45rem 0 0.6rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid currentColor;
    border-radius: 6px;
    color: var(--publication-link);
    background: color-mix(in srgb, var(--publication-link) 8%, transparent);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .publication-links a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    border: 0;
  }

  .publication-links span {
    color: var(--publication-link);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .publication-links a:hover span {
    color: var(--publication-blue);
  }

  .publication-card a:focus-visible {
    outline: 2px solid var(--publication-blue);
    outline-offset: 4px;
    border-radius: 2px;
  }

  :global(html.dark) .publication-list {
    --publication-border: #3c485d;
    --publication-accent: #596b89;
    --publication-blue: #9ebff6;
    --publication-link: #e6bc68;
  }

  @media (max-width: 640px) {
    .publication-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.1rem;
      padding: 1.25rem;
      border-left-width: 5px;
      border-radius: 16px;
    }

    .publication-thumbnail {
      width: 144px;
    }

    .publication-authors {
      font-size: 1.05rem;
    }

    .publication-venue {
      font-size: 1.1rem;
    }

    .publication-links a {
      min-height: 44px;
    }
  }
</style>
