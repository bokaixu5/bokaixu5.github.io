---
import { getCollection, type CollectionEntry } from "astro:content";

import SearchBox from "../../../components/SearchBox.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { SUPPORTED_LANGS, getOtherLang, t, type Lang } from "../../../config/i18n";
import { getSlug, sortPostsByDateDesc } from "../../../utils/content";
import { readingTimeLabel } from "../../../utils/readingTime";

export async function getStaticPaths() {
  const allPosts = (await getCollection("posts")).filter((post) => !post.data.draft);
  return SUPPORTED_LANGS.map((lang) => ({
    params: { lang },
    props: {
      lang,
      posts: sortPostsByDateDesc(allPosts.filter((post) => post.data.lang === lang)),
    },
  }));
}

interface Props {
  lang: Lang;
  posts: CollectionEntry<"posts">[];
}

const { lang, posts } = Astro.props as Props;
const text = t(lang);
const otherLang = getOtherLang(lang);
---

<BaseLayout
  lang={lang}
  title={text.blog.title}
  description={text.blog.subtitle}
  currentPath={`/${lang}/blog/`}
  alternateHref={`/${otherLang}/blog/`}
>
  <section class="panel reveal" style="margin-bottom:1rem;">
    <h1>{text.blog.title}</h1>
    <p style="color:var(--muted);margin-bottom:0;">{text.blog.subtitle}</p>
  </section>

  <SearchBox lang={lang} />

  <section style="margin-top:1rem;" class="grid">
    {
      posts.length ? (
        posts.map((post) => (
          <article class="panel reveal">
            <h2 style="margin-bottom:0.35rem;">
              <a href={`/${lang}/blog/${getSlug(post.id)}/`}>{post.data.title}</a>
            </h2>
            <p style="color:var(--muted);margin-bottom:0.55rem;">{post.data.description}</p>
            <div class="meta-row">
              <span>{post.data.date.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-US")}</span>
              <span>·</span>
              <span>{readingTimeLabel(post.body ?? "", lang)}</span>
            </div>
            <div class="tags" style="margin-top:0.65rem;">
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </article>
        ))
      ) : (
        <p>{text.common.noContent}</p>
      )
    }
  </section>
</BaseLayout>
