---
import { getCollection, render, type CollectionEntry } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { SUPPORTED_LANGS, getOtherLang, type Lang } from "../../config/i18n";

type AboutEntry = CollectionEntry<"about">;

export async function getStaticPaths() {
  const allAbout = await getCollection("about");

  return SUPPORTED_LANGS.map((lang) => {
    const about = allAbout.find((entry) => entry.data.lang === lang);
    if (!about) {
      throw new Error(`Missing about markdown for language: ${lang}`);
    }

    return {
      params: { lang },
      props: { lang, about },
    };
  });
}

interface Props {
  lang: Lang;
  about: AboutEntry;
}

const { lang, about } = Astro.props as Props;
const otherLang = getOtherLang(lang);
const { Content } = await render(about);
---

<BaseLayout
  lang={lang}
  title={about.data.title}
  description={about.data.subtitle}
  currentPath={`/${lang}/about/`}
  alternateHref={`/${otherLang}/about/`}
>
  <article class="panel reveal content-prose">
    <h1>{about.data.title}</h1>
    <p style="color:var(--muted);font-size:1.02rem;">{about.data.subtitle}</p>
    <Content />
  </article>
</BaseLayout>

