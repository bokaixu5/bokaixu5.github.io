---
import { getCollection, type CollectionEntry } from "astro:content";

import SocialLinks from "../../components/SocialLinks.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SUPPORTED_LANGS, getOtherLang, t, type Lang } from "../../config/i18n";
import { getSlug, sortPostsByDateDesc } from "../../utils/content";

export async function getStaticPaths() {
  const allPosts = (await getCollection("posts")).filter((post) => !post.data.draft);
  const allProjects = await getCollection("projects");

  return SUPPORTED_LANGS.map((lang) => {
    const posts = sortPostsByDateDesc(
      allPosts.filter((post) => post.data.lang === lang),
    ).slice(0, 2);
    const projects = allProjects
      .filter((project) => project.data.lang === lang)
      .sort((a, b) => Number(b.data.featured ?? false) - Number(a.data.featured ?? false))
      .slice(0, 3);
    return {
      params: { lang },
      props: {
        lang,
        posts,
        projects,
      },
    };
  });
}

interface Props {
  lang: Lang;
  posts: CollectionEntry<"posts">[];
  projects: CollectionEntry<"projects">[];
}

const { lang, posts, projects } = Astro.props as Props;
const text = t(lang);
const otherLang = getOtherLang(lang);
const profilePhotoAlt = lang === "zh" ? "Bokai 的头像照片" : "Portrait photo of Bokai";
const clapUi =
  lang === "zh"
    ? {
        defaultLabel: "拍手",
        loadingLabel: "提交中...",
        unavailableLabel: "暂不可用",
      }
    : {
        defaultLabel: "Clap",
        loadingLabel: "Saving...",
        unavailableLabel: "Unavailable",
      };
---

<BaseLayout
  lang={lang}
  title={text.home.title}
  description={text.home.intro}
  currentPath={`/${lang}/`}
  alternateHref={`/${otherLang}/`}
>
  <section class="reveal panel home-hero" style="margin-bottom:1.1rem;">
    <img
      class="home-avatar"
      src="/images/bokai.jpg"
      alt={profilePhotoAlt}
      width="152"
      height="152"
      loading="eager"
      decoding="async"
    />
    <div class="home-intro">
      <div class="home-title-row" data-home-clap>
        <button
          type="button"
          class="home-clap-button"
          data-clap-button
          data-label-default={clapUi.defaultLabel}
          data-label-loading={clapUi.loadingLabel}
          data-label-unavailable={clapUi.unavailableLabel}
          aria-label={clapUi.defaultLabel}
        >
          <span class="home-clap-icon" aria-hidden="true">👏</span>
          <span class="home-clap-count" data-clap-count hidden></span>
        </button>
        <h1>{text.home.title}</h1>
      </div>
      <p style="font-size:1.03rem;color:var(--muted);max-width:58ch;">{text.home.intro}</p>
    </div>
  </section>

  <section class="reveal" style="margin-bottom:1.4rem;">
    <SocialLinks lang={lang} variant="home" />
  </section>

  <script is:inline>
    (() => {
      const roots = document.querySelectorAll("[data-home-clap]");
      for (const root of roots) {
        if (!(root instanceof HTMLElement) || root.dataset.clapBound === "1") {
          continue;
        }
        root.dataset.clapBound = "1";

        const button = root.querySelector("[data-clap-button]");
        const countEl = root.querySelector("[data-clap-count]");
        if (!(button instanceof HTMLButtonElement) || !(countEl instanceof HTMLElement)) {
          continue;
        }

        const namespace = "bokaixu5-github-io";
        const key = "home-clap-total";
        let inFlight = false;

        const setLabel = (label) => {
          button.setAttribute("aria-label", label);
          button.title = label;
        };

        const revealCount = (value) => {
          countEl.hidden = false;
          countEl.textContent = String(value);
          button.classList.add("has-count", "is-popped");
          window.setTimeout(() => {
            button.classList.remove("is-popped");
          }, 180);
        };

        const markUnavailable = () => {
          const unavailable = button.dataset.labelUnavailable || "Unavailable";
          button.disabled = true;
          button.classList.add("is-unavailable");
          countEl.hidden = false;
          countEl.textContent = unavailable;
          setLabel(unavailable);
        };

        button.addEventListener("click", async () => {
          if (inFlight || button.disabled) {
            return;
          }
          inFlight = true;
          button.disabled = true;
          button.classList.add("is-loading");
          setLabel(button.dataset.labelLoading || "Saving...");

          try {
            const response = await fetch(`https://api.countapi.xyz/hit/${namespace}/${key}`, {
              method: "GET",
              cache: "no-store",
            });
            if (!response.ok) {
              throw new Error(`Count API error: ${response.status}`);
            }
            const payload = await response.json();
            if (typeof payload?.value !== "number") {
              throw new Error("Count API response is missing numeric value");
            }
            revealCount(payload.value);
            button.disabled = false;
          } catch (_error) {
            markUnavailable();
          } finally {
            inFlight = false;
            button.classList.remove("is-loading");
            if (!button.disabled) {
              setLabel(button.dataset.labelDefault || "Clap");
            }
          }
        });

        setLabel(button.dataset.labelDefault || "Clap");
      }
    })();
  </script>

  <section style="margin-top:1.4rem;">
    <div class="section-head">
      <h2>{text.common.latestPosts}</h2>
      <a href={`/${lang}/blog/`}>{text.common.viewAll}</a>
    </div>
    <div class="grid">
      {
        posts.length ? (
          posts.map((post) => (
            <article class="panel reveal">
              <h3 style="margin-bottom:0.45rem;">
                <a href={`/${lang}/blog/${getSlug(post.id)}/`}>{post.data.title}</a>
              </h3>
              <p style="margin-bottom:0.3rem;color:var(--muted);">
                {post.data.date.toLocaleDateString(lang === "zh" ? "zh-CN" : "en-US")}
              </p>
              <p style="margin-bottom:0;">{post.data.description}</p>
            </article>
          ))
        ) : (
          <p>{text.common.noContent}</p>
        )
      }
    </div>
  </section>

  <section style="margin-top:2rem;">
    <div class="section-head">
      <h2>{text.common.featuredProjects}</h2>
      <a href={`/${lang}/projects/`}>{text.common.viewAll}</a>
    </div>
    <div class="grid grid-2">
      {
        projects.length ? (
          projects.map((project) => (
            <article class="panel reveal">
              <h3 style="margin-bottom:0.45rem;">
                <a href={`/${lang}/projects/${getSlug(project.id)}/`}>{project.data.title}</a>
              </h3>
              <p style="margin-bottom:0.5rem;">{project.data.summary}</p>
              <p class="meta-row" style="margin:0;">
                {project.data.tech.slice(0, 3).join(" · ")}
              </p>
            </article>
          ))
        ) : (
          <p>{text.common.noContent}</p>
        )
      }
    </div>
  </section>
</BaseLayout>
